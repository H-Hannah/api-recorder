{
  "name": "pscs-record-plugin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "serve": "NODE_OPTIONS=--openssl-legacy-provider vue-cli-service serve",
    "build": "./build.sh",
    "build:direct": "NODE_OPTIONS=--openssl-legacy-provider vue-cli-service build",
    "lint": "NODE_OPTIONS=--openssl-legacy-provider vue-cli-service lint",
    "watch": "NODE_OPTIONS=--openssl-legacy-provider vue-cli-service build --watch"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^0.2.7",
    "element-plus": "^1.3.0-beta.5",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@vue/cli-plugin-babel": "~4.5.0",
    "@vue/cli-plugin-eslint": "~4.5.0",
    "@vue/cli-service": "~4.5.0",
    "@vue/compiler-sfc": "^3.0.0",
    "babel-eslint": "^10.1.0",
    "copy-webpack-plugin": "^6.0.2",
    "eslint": "^6.7.2",
    "eslint-plugin-vue": "^7.0.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "babel-eslint"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
